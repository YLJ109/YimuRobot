# ════════════════════════════════════════════════════════════════
#  埃夫特 ER3-600 机器人仿真系统 — 后端环境变量样例
# ════════════════════════════════════════════════════════════════
#  用法：复制为 .env 并填入真实值。.env 已被 .gitignore 忽略，
#        严禁把真实密钥提交到任何版本库。
#  仅本文件（.env.example）可以进版本库，且只放占位符。
# ════════════════════════════════════════════════════════════════

# ── LLM 网关（智谱 GLM）──
#  申请地址：https://open.bigmodel.cn/
#  未配置时 AI 自然语言功能自动降级（快通道仍可用）
ZHIPU_API_KEY=your_zhipu_api_key_here

# ── 语音识别 ──
#  模型规格：tiny / base / small / medium（越大越准、越慢）
WHISPER_MODEL=small
#  是否启用唤醒词：true 时必须先说「小艺小艺」；false 则直接识别指令
WAKE_WORD_ENABLED=false

# ── 服务监听 ──
HOST=0.0.0.0
PORT=5000
#  开发=development（放宽 CORS 到本机前端端口）
#  生产=production（CORS 只允许 CORS_ORIGINS 中显式列出的来源）
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── 安全上限（硬编码兜底，此处可覆盖）──
#  LOOP 展开后允许的最大指令条数
MAX_EXPANDED_INSTRUCTIONS=20000
#  单条 WAIT 的最大时长（秒）
MAX_WAIT_SECONDS=60
#  单个程序的最大执行时长（秒）
MAX_EXEC_SECONDS=300

# ── 日志 ──
LOG_LEVEL=INFO
